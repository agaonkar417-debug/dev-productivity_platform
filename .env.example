# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# `.env` is git-ignored. Both the app and `docker compose` read it.

# PostgreSQL connection used when you run the app from source (./mvnw spring-boot:run).
# Port 5433 matches docker-compose.db-port.yml. Use 5432 for a PostgreSQL you installed yourself.
# (start.bat / start.sh run the app inside Docker and ignore DB_URL.)
DB_URL=jdbc:postgresql://localhost:5433/devflow
DB_USERNAME=devflow
DB_PASSWORD=change-me-to-a-long-random-value

# Used by docker-compose.yml when it creates the database container.
# Keep POSTGRES_PASSWORD equal to DB_PASSWORD.
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Port for the database when using docker-compose.db-port.yml
# DB_PORT=5433

# Optional web server settings (start scripts pick a free port automatically if 8080 is taken)
# PORT=8080
# SERVER_ADDRESS=127.0.0.1
